<Window x:Class="ImageDisplayApp.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Settings" SizeToContent="WidthAndHeight" ResizeMode="NoResize"
        WindowStartupLocation="CenterOwner" ShowInTaskbar="False"
        PreviewKeyDown="Window_PreviewKeyDown">

    <StackPanel Margin="18" MinWidth="460">
        <TextBlock Text="Hotkeys" FontSize="15" FontWeight="SemiBold"/>
        <TextBlock Margin="0,4,0,14" TextWrapping="Wrap" Opacity="0.7"
                   Text="Global: they work while a game has focus, and they control every running copy of the app at once. Click a button, then press the new keys. Esc cancels."/>

        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <TextBlock Grid.Row="0" Grid.Column="0" Text="View / edit mode" VerticalAlignment="Center" Margin="0,0,16,8"/>
            <Button x:Name="btnEdit" Grid.Row="0" Grid.Column="1" Tag="0" Click="Capture_Click"
                    Padding="10,5" Margin="0,0,0,8" HorizontalContentAlignment="Left"/>

            <TextBlock Grid.Row="1" Grid.Column="0" Text="Interact with the cloned window" VerticalAlignment="Center" Margin="0,0,16,8"/>
            <Button x:Name="btnInteract" Grid.Row="1" Grid.Column="1" Tag="1" Click="Capture_Click"
                    Padding="10,5" Margin="0,0,0,8" HorizontalContentAlignment="Left"/>

            <TextBlock Grid.Row="2" Grid.Column="0" Text="Hide / show everything" VerticalAlignment="Center" Margin="0,0,16,8"/>
            <Button x:Name="btnHide" Grid.Row="2" Grid.Column="1" Tag="2" Click="Capture_Click"
                    Padding="10,5" Margin="0,0,0,8" HorizontalContentAlignment="Left"/>
        </Grid>

        <TextBlock x:Name="messageText" Foreground="#C0392B" TextWrapping="Wrap" Margin="0,4,0,0" MinHeight="18"/>

        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,14,0,0">
            <Button Content="Reset to defaults" Padding="12,5" Margin="0,0,8,0" Click="Reset_Click"/>
            <Button Content="Save" Padding="18,5" Margin="0,0,8,0" IsDefault="True" Click="Save_Click"/>
            <Button Content="Cancel" Padding="14,5" IsCancel="True" Click="Cancel_Click"/>
        </StackPanel>
    </StackPanel>
</Window>
