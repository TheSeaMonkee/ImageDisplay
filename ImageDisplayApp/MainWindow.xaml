<Window x:Class="ImageDisplayApp.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Image Display"
        Left="-32000" Top="-32000" Width="1" Height="1" WindowStartupLocation="Manual"
        WindowStyle="None" ResizeMode="NoResize" Background="#FF101010"
        ShowActivated="False" Loaded="Window_Loaded">

    <!--
      This window only hosts the live replica of another window (a DWM thumbnail), so it must be opaque: DWM does
      not draw thumbnails on per-pixel-transparent windows. When nothing is being cloned it is parked as a 1x1
      window off-screen, which is what lets an image-only overlay have a truly transparent background.
      Everything that must appear above the replica (the overlay image, the toolbar) lives in separate windows,
      because a DWM thumbnail is always drawn above anything this window renders itself.
    -->
    <Grid/>
</Window>
