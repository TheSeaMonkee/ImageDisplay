<Window x:Class="ImageDisplayApp.CropWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Crop the cloned window" SizeToContent="WidthAndHeight" ResizeMode="NoResize"
        WindowStartupLocation="CenterOwner" ShowInTaskbar="False" ShowActivated="False">

    <StackPanel Margin="18" MinWidth="380">
        <TextBlock TextWrapping="Wrap" Opacity="0.7" Margin="0,0,0,14"
                   Text="Trim the edges of the cloned window to hide parts of its interface. The overlay updates as you drag."/>

        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="56"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="44"/>
            </Grid.ColumnDefinitions>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <TextBlock Grid.Row="0" Text="Left" VerticalAlignment="Center"/>
            <Slider x:Name="sldLeft" Grid.Row="0" Grid.Column="1" Minimum="0" Maximum="80" TickFrequency="1"
                    IsSnapToTickEnabled="True" Margin="0,4" ValueChanged="Slider_ValueChanged"/>
            <TextBlock x:Name="txtLeft" Grid.Row="0" Grid.Column="2" Text="0%" HorizontalAlignment="Right" VerticalAlignment="Center"/>

            <TextBlock Grid.Row="1" Text="Top" VerticalAlignment="Center"/>
            <Slider x:Name="sldTop" Grid.Row="1" Grid.Column="1" Minimum="0" Maximum="80" TickFrequency="1"
                    IsSnapToTickEnabled="True" Margin="0,4" ValueChanged="Slider_ValueChanged"/>
            <TextBlock x:Name="txtTop" Grid.Row="1" Grid.Column="2" Text="0%" HorizontalAlignment="Right" VerticalAlignment="Center"/>

            <TextBlock Grid.Row="2" Text="Right" VerticalAlignment="Center"/>
            <Slider x:Name="sldRight" Grid.Row="2" Grid.Column="1" Minimum="0" Maximum="80" TickFrequency="1"
                    IsSnapToTickEnabled="True" Margin="0,4" ValueChanged="Slider_ValueChanged"/>
            <TextBlock x:Name="txtRight" Grid.Row="2" Grid.Column="2" Text="0%" HorizontalAlignment="Right" VerticalAlignment="Center"/>

            <TextBlock Grid.Row="3" Text="Bottom" VerticalAlignment="Center"/>
            <Slider x:Name="sldBottom" Grid.Row="3" Grid.Column="1" Minimum="0" Maximum="80" TickFrequency="1"
                    IsSnapToTickEnabled="True" Margin="0,4" ValueChanged="Slider_ValueChanged"/>
            <TextBlock x:Name="txtBottom" Grid.Row="3" Grid.Column="2" Text="0%" HorizontalAlignment="Right" VerticalAlignment="Center"/>
        </Grid>

        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,14,0,0">
            <Button Content="Reset" Padding="14,5" Margin="0,0,8,0" Click="Reset_Click"/>
            <Button Content="Done" Padding="18,5" IsDefault="True" IsCancel="True" Click="Done_Click"/>
        </StackPanel>
    </StackPanel>
</Window>
